<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>59.0</apiVersion>
    <description>Daily scheduled flow that creates birthday reminder tasks for contacts with birthdays today. Runs at 8:00 AM and deduplicates tasks to prevent duplicates.</description>
    <interviewLabel>Contact Birthday Reminder Flow</interviewLabel>
    <isTemplate>false</isTemplate>
    <label>Contact Birthday Reminder Flow</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>FREE_FORM_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>ScheduledFlow</processType>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Contacts_With_Birthday_Today</targetReference>
        </connector>
        <object>Contact</object>
        <schedule>
            <frequency>Daily</frequency>
            <startTime>08:00:00.000Z</startTime>
        </schedule>
        <triggerType>Scheduled</triggerType>
    </start>
    <decisions>
        <name>Contact_Has_Birthdays</name>
        <label>Contact Has Birthdays</label>
        <locationX>776</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>End_Flow</targetReference>
        </defaultConnector>
        <rules>
            <name>Has_Birthdays</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Contacts_With_Birthday_Today</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Loop_Through_Contacts</targetReference>
            </connector>
            <label>Has Birthdays</label>
        </rules>
    </decisions>
    <loops>
        <name>Loop_Through_Contacts</name>
        <label>Loop Through Contacts</label>
        <locationX>950</locationX>
        <locationY>0</locationY>
        <collectionReference>Get_Contacts_With_Birthday_Today</collectionReference>
        <nextValueConnector>
            <targetReference>Check_For_Existing_Task</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>End_Flow</targetReference>
        </noMoreValuesConnector>
    </loops>
    <recordLookups>
        <name>Get_Contacts_With_Birthday_Today</name>
        <label>Get Contacts With Birthday Today</label>
        <locationX>408</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Contact_Has_Birthdays</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Birthday__c</field>
            <operator>NotEqualTo</operator>
            <value>
                <elementReference>$GlobalConstant.NULL</elementReference>
            </value>
        </filters>
        <object>Contact</object>
        <outputReference>Get_Contacts_With_Birthday_Today</outputReference>
        <queriedFields>Id</queriedFields>
        <queriedFields>Name</queriedFields>
        <queriedFields>OwnerId</queriedFields>
        <queriedFields>Birthday__c</queriedFields>
        <sortField>Name</sortField>
        <sortOrder>Asc</sortOrder>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Check_For_Existing_Task</name>
        <label>Check For Existing Task</label>
        <locationX>1124</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Task_Exists</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>WhoId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Loop_Through_Contacts.Id</elementReference>
            </value>
        </filters>
        <filters>
            <field>Subject</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Wish {!Loop_Through_Contacts.Name} a happy birthday</stringValue>
            </value>
        </filters>
        <filters>
            <field>ActivityDate</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Flow.CurrentDate</elementReference>
            </value>
        </filters>
        <object>Task</object>
        <outputReference>Existing_Task</outputReference>
        <queriedFields>Id</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <decisions>
        <name>Task_Exists</name>
        <label>Task Exists</label>
        <locationX>1298</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Create_Birthday_Task</targetReference>
        </defaultConnector>
        <rules>
            <name>Task_Already_Exists</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Existing_Task</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Loop_Through_Contacts</targetReference>
            </connector>
            <label>Task Already Exists</label>
        </rules>
    </decisions>
    <recordCreates>
        <name>Create_Birthday_Task</name>
        <label>Create Birthday Task</label>
        <locationX>1472</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Loop_Through_Contacts</targetReference>
        </connector>
        <inputSObjectType>Task</inputSObjectType>
        <object>Task</object>
        <recordInput>
            <sobjectType>Task</sobjectType>
            <values>
                <name>ActivityDate</name>
                <value>
                    <elementReference>$Flow.CurrentDate</elementReference>
                </value>
            </values>
            <values>
                <name>Subject</name>
                <value>
                    <stringValue>Wish {!Loop_Through_Contacts.Name} a happy birthday</stringValue>
                </value>
            </values>
            <values>
                <name>WhoId</name>
                <value>
                    <elementReference>Loop_Through_Contacts.Id</elementReference>
                </value>
            </values>
            <values>
                <name>OwnerId</name>
                <value>
                    <elementReference>Loop_Through_Contacts.OwnerId</elementReference>
                </value>
            </values>
        </recordInput>
    </recordCreates>
    <decisions>
        <name>End_Flow</name>
        <label>End Flow</label>
        <locationX>1646</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Done</defaultConnectorLabel>
    </decisions>
    <variables>
        <name>Existing_Task</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>Task</objectType>
    </variables>
</Flow>