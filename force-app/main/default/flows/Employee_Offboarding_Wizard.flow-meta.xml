<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>67.0</apiVersion>
    <description>Screen Flow that walks a manager through the employee offboarding process, collecting offboarding details, updating the user record, and creating IT and HR tasks.</description>
    <interviewLabel>Employee Offboarding Wizard {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Employee Offboarding Wizard</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>Flow</processType>
    <status>Draft</status>
    <variables>
        <name>varSelectedUserId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>varSelectedUser</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>User</objectType>
    </variables>
    <variables>
        <name>varEmployeeName</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>varOffboardingType</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>varLastDay</name>
        <dataType>Date</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>varExitInterviewPreference</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>varTerminationReason</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>varImmediateAccessRevocation</name>
        <dataType>Boolean</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <value><booleanValue>false</booleanValue></value>
    </variables>
    <variables>
        <name>varITTaskId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>varHRTaskId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
    <formulas>
        <name>frmITTaskSubject</name>
        <dataType>String</dataType>
        <expression>"License Revocation - " &amp; {!varEmployeeName}</expression>
    </formulas>
    <formulas>
        <name>frmHRTaskSubject</name>
        <dataType>String</dataType>
        <expression>"Exit Interview Scheduling - " &amp; {!varEmployeeName}</expression>
    </formulas>
    <formulas>
        <name>frmOffboardingStatusValue</name>
        <dataType>String</dataType>
        <expression>IF({!varOffboardingType} = "Resignation", "Resignation - Pending", "Terminated - Pending")</expression>
    </formulas>
    <formulas>
        <name>frmLastDayDisplay</name>
        <dataType>String</dataType>
        <expression>IF(ISNULL({!varLastDay}), "N/A", TEXT({!varLastDay}))</expression>
    </formulas>
    <formulas>
        <name>frmSummaryDetails</name>
        <dataType>String</dataType>
        <expression>"Employee: " &amp; {!varEmployeeName} &amp; BR() &amp; "Offboarding Type: " &amp; {!varOffboardingType} &amp; BR() &amp; IF({!varOffboardingType} = "Resignation", "Last Day: " &amp; {!frmLastDayDisplay} &amp; BR() &amp; "Exit Interview: " &amp; {!varExitInterviewPreference}, "Termination Reason: " &amp; {!varTerminationReason} &amp; BR() &amp; "Immediate Access Revocation: " &amp; TEXT({!varImmediateAccessRevocation}))</expression>
    </formulas>
    <start>
        <locationX>176</locationX>
        <locationY>48</locationY>
        <connector><targetReference>Screen_Welcome</targetReference></connector>
    </start>
    <screens>
        <name>Screen_Welcome</name>
        <label>Welcome – Select Employee</label>
        <locationX>176</locationX>
        <locationY>180</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <connector><targetReference>Lookup_SelectedUser</targetReference></connector>
        <fields>
            <name>DisplayText_Welcome</name>
            <fieldText>&lt;p&gt;&lt;strong&gt;Employee Offboarding Wizard&lt;/strong&gt;&lt;/p&gt;&lt;p&gt;Welcome. This wizard will guide you through the employee offboarding process. Please search for and select the employee being offboarded.&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
        </fields>
        <fields>
            <name>Input_EmployeeLookup</name>
            <dataType>String</dataType>
            <fieldText>Select Employee (User ID)</fieldText>
            <fieldType>InputField</fieldType>
            <isRequired>true</isRequired>
            <outputParameters>
                <assignToReference>varSelectedUserId</assignToReference>
                <name>value</name>
            </outputParameters>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <recordLookups>
        <name>Lookup_SelectedUser</name>
        <label>Get Selected User</label>
        <locationX>176</locationX>
        <locationY>320</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector><targetReference>Assign_EmployeeName</targetReference></connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value><elementReference>varSelectedUserId</elementReference></value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>User</object>
        <outputAssignments>
            <assignToReference>varSelectedUser</assignToReference>
        </outputAssignments>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <assignments>
        <name>Assign_EmployeeName</name>
        <label>Set Employee Name</label>
        <locationX>176</locationX>
        <locationY>440</locationY>
        <assignmentItems>
            <assignToReference>varEmployeeName</assignToReference>
            <operator>Assign</operator>
            <value><elementReference>Lookup_SelectedUser.Name</elementReference></value>
        </assignmentItems>
        <connector><targetReference>Screen_OffboardingType</targetReference></connector>
    </assignments>
    <screens>
        <name>Screen_OffboardingType</name>
        <label>Offboarding Type</label>
        <locationX>176</locationX>
        <locationY>560</locationY>
        <allowBack>true</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <connector><targetReference>Decision_OffboardingType</targetReference></connector>
        <fields>
            <name>DisplayText_OffboardingTypeHeader</name>
            <fieldText>&lt;p&gt;&lt;strong&gt;Offboarding Type&lt;/strong&gt;&lt;/p&gt;&lt;p&gt;Employee: &lt;strong&gt;{!varEmployeeName}&lt;/strong&gt;&lt;/p&gt;&lt;p&gt;Select the offboarding type.&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
        </fields>
        <fields>
            <name>Input_OffboardingType</name>
            <dataType>String</dataType>
            <defaultValue><stringValue>Resignation</stringValue></defaultValue>
            <fieldText>Offboarding Type</fieldText>
            <fieldType>RadioButtons</fieldType>
            <isRequired>true</isRequired>
            <choiceReferences>Choice_Resignation</choiceReferences>
            <choiceReferences>Choice_Termination</choiceReferences>
            <outputParameters>
                <assignToReference>varOffboardingType</assignToReference>
                <name>value</name>
            </outputParameters>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <choices>
        <name>Choice_Resignation</name>
        <choiceText>Resignation</choiceText>
        <dataType>String</dataType>
        <value><stringValue>Resignation</stringValue></value>
    </choices>
    <choices>
        <name>Choice_Termination</name>
        <choiceText>Termination</choiceText>
        <dataType>String</dataType>
        <value><stringValue>Termination</stringValue></value>
    </choices>
    <choices>
        <name>Choice_ExitInterviewYes</name>
        <choiceText>Yes</choiceText>
        <dataType>String</dataType>
        <value><stringValue>Yes</stringValue></value>
    </choices>
    <choices>
        <name>Choice_ExitInterviewNo</name>
        <choiceText>No</choiceText>
        <dataType>String</dataType>
        <value><stringValue>No</stringValue></value>
    </choices>
    <decisions>
        <name>Decision_OffboardingType</name>
        <label>Offboarding Type Branch</label>
        <locationX>176</locationX>
        <locationY>700</locationY>
        <defaultConnector><targetReference>Screen_TerminationDetails</targetReference></defaultConnector>
        <defaultConnectorLabel>Termination</defaultConnectorLabel>
        <rules>
            <name>Rule_Resignation</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varOffboardingType</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue><stringValue>Resignation</stringValue></rightValue>
            </conditions>
            <connector><targetReference>Screen_ResignationDetails</targetReference></connector>
            <label>Resignation</label>
        </rules>
    </decisions>
    <screens>
        <name>Screen_ResignationDetails</name>
        <label>Resignation Details</label>
        <locationX>-100</locationX>
        <locationY>860</locationY>
        <allowBack>true</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <connector><targetReference>Screen_Confirmation</targetReference></connector>
        <fields>
            <name>DisplayText_ResignationHeader</name>
            <fieldText>&lt;p&gt;&lt;strong&gt;Resignation Details&lt;/strong&gt;&lt;/p&gt;&lt;p&gt;Provide details for the employee resignation.&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
        </fields>
        <fields>
            <name>Input_LastDay</name>
            <dataType>Date</dataType>
            <fieldText>Last Day of Employment</fieldText>
            <fieldType>InputField</fieldType>
            <isRequired>true</isRequired>
            <outputParameters>
                <assignToReference>varLastDay</assignToReference>
                <name>value</name>
            </outputParameters>
        </fields>
        <fields>
            <name>Input_ExitInterviewPreference</name>
            <dataType>String</dataType>
            <defaultValue><stringValue>Yes</stringValue></defaultValue>
            <fieldText>Would the employee like an exit interview?</fieldText>
            <fieldType>RadioButtons</fieldType>
            <isRequired>true</isRequired>
            <choiceReferences>Choice_ExitInterviewYes</choiceReferences>
            <choiceReferences>Choice_ExitInterviewNo</choiceReferences>
            <outputParameters>
                <assignToReference>varExitInterviewPreference</assignToReference>
                <name>value</name>
            </outputParameters>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <screens>
        <name>Screen_TerminationDetails</name>
        <label>Termination Details</label>
        <locationX>460</locationX>
        <locationY>860</locationY>
        <allowBack>true</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <connector><targetReference>Screen_Confirmation</targetReference></connector>
        <fields>
            <name>DisplayText_TerminationHeader</name>
            <fieldText>&lt;p&gt;&lt;strong&gt;Termination Details&lt;/strong&gt;&lt;/p&gt;&lt;p&gt;Provide details for the employee termination.&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
        </fields>
        <fields>
            <name>Input_TerminationReason</name>
            <dataType>String</dataType>
            <fieldText>Termination Reason</fieldText>
            <fieldType>InputField</fieldType>
            <isRequired>true</isRequired>
            <outputParameters>
                <assignToReference>varTerminationReason</assignToReference>
                <name>value</name>
            </outputParameters>
        </fields>
        <fields>
            <name>Input_ImmediateAccessRevocation</name>
            <dataType>Boolean</dataType>
            <fieldText>Immediate Access Revocation Required?</fieldText>
            <fieldType>InputField</fieldType>
            <isRequired>false</isRequired>
            <outputParameters>
                <assignToReference>varImmediateAccessRevocation</assignToReference>
                <name>value</name>
            </outputParameters>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <screens>
        <name>Screen_Confirmation</name>
        <label>Confirmation Summary</label>
        <locationX>176</locationX>
        <locationY>980</locationY>
        <allowBack>true</allowBack>
        <allowFinish>false</allowFinish>
        <allowPause>false</allowPause>
        <connector><targetReference>Create_ITTask</targetReference></connector>
        <fields>
            <name>DisplayText_ConfirmationHeader</name>
            <fieldText>&lt;p&gt;&lt;strong&gt;Confirm Offboarding Details&lt;/strong&gt;&lt;/p&gt;&lt;p&gt;Please review the offboarding details below. Click &lt;strong&gt;Next&lt;/strong&gt; to proceed.&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
        </fields>
        <fields>
            <name>DisplayText_SummaryDetails</name>
            <fieldText>{!frmSummaryDetails}</fieldText>
            <fieldType>DisplayText</fieldType>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <screens>
        <name>Screen_Success</name>
        <label>Success – Offboarding Complete</label>
        <locationX>176</locationX>
        <locationY>1340</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <fields>
            <name>DisplayText_SuccessMessage</name>
            <fieldText>&lt;p&gt;&lt;strong&gt;Offboarding Process Complete&lt;/strong&gt;&lt;/p&gt;&lt;p&gt;The employee offboarding has been successfully initiated.&lt;/p&gt;&lt;ul&gt;&lt;li&gt;Employee: {!varEmployeeName}&lt;/li&gt;&lt;li&gt;Offboarding Type: {!varOffboardingType}&lt;/li&gt;&lt;li&gt;IT Task created for license revocation.&lt;/li&gt;&lt;li&gt;HR Task created for exit interview scheduling.&lt;/li&gt;&lt;li&gt;User account has been deactivated.&lt;/li&gt;&lt;/ul&gt;&lt;p&gt;The offboarding process is now complete.&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <recordCreates>
        <name>Create_ITTask</name>
        <label>Create IT Task</label>
        <locationX>-100</locationX>
        <locationY>1100</locationY>
        <connector><targetReference>Create_HRTask</targetReference></connector>
        <inputAssignments>
            <field>Subject</field>
            <value><elementReference>frmITTaskSubject</elementReference></value>
        </inputAssignments>
        <inputAssignments>
            <field>ActivityDate</field>
            <value><elementReference>varLastDay</elementReference></value>
        </inputAssignments>
        <inputAssignments>
            <field>Status</field>
            <value><stringValue>Open</stringValue></value>
        </inputAssignments>
        <inputAssignments>
            <field>Priority</field>
            <value><stringValue>High</stringValue></value>
        </inputAssignments>
        <object>Task</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordCreates>
    <recordCreates>
        <name>Create_HRTask</name>
        <label>Create HR Task</label>
        <locationX>460</locationX>
        <locationY>1100</locationY>
        <connector><targetReference>Update_UserOffboardingStatus</targetReference></connector>
        <inputAssignments>
            <field>Subject</field>
            <value><elementReference>frmHRTaskSubject</elementReference></value>
        </inputAssignments>
        <inputAssignments>
            <field>ActivityDate</field>
            <value><elementReference>varLastDay</elementReference></value>
        </inputAssignments>
        <inputAssignments>
            <field>Status</field>
            <value><stringValue>Open</stringValue></value>
        </inputAssignments>
        <inputAssignments>
            <field>Priority</field>
            <value><stringValue>High</stringValue></value>
        </inputAssignments>
        <object>Task</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordCreates>
    <recordUpdates>
        <name>Update_UserOffboardingStatus</name>
        <label>Update User Offboarding Status</label>
        <locationX>176</locationX>
        <locationY>1220</locationY>
        <connector><targetReference>Screen_Success</targetReference></connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value><elementReference>varSelectedUserId</elementReference></value>
        </filters>
        <object>User</object>
        <recordUpdates>
            <field>IsActive</field>
            <value><booleanValue>false</booleanValue></value>
        </recordUpdates>
    </recordUpdates>
</Flow>