<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>59.0</apiVersion>
    <assignments>
        <name>Assign_EmployeeName</name>
        <label>Assign Employee Name</label>
        <locationX>176</locationX>
        <locationY>348</locationY>
        <assignmentItems>
            <assignToReference>varEmployeeName</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Lookup_SelectedUser.Name</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Screen_OffboardingType</targetReference>
        </connector>
    </assignments>
    <decisions>
        <name>Decision_OffboardingType</name>
        <label>Decision Offboarding Type</label>
        <locationX>176</locationX>
        <locationY>588</locationY>
        <defaultConnectorLabel>Termination</defaultConnectorLabel>
        <defaultConnector>
            <targetReference>Screen_TerminationDetails</targetReference>
        </defaultConnector>
        <rules>
            <name>Resignation_Path</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varOffboardingType</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Resignation</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Screen_ResignationDetails</targetReference>
            </connector>
            <label>Resignation</label>
        </rules>
    </decisions>
    <description>Employee Offboarding Wizard - manages resignation and termination workflows</description>
    <formulas>
        <name>frmHRTaskSubject</name>
        <dataType>String</dataType>
        <expression>"Exit Interview Scheduling - " &amp; {!varEmployeeName}</expression>
    </formulas>
    <formulas>
        <name>frmITTaskSubject</name>
        <dataType>String</dataType>
        <expression>"License Revocation - " &amp; {!varEmployeeName}</expression>
    </formulas>
    <formulas>
        <name>frmOffboardingStatusValue</name>
        <dataType>String</dataType>
        <expression>IF({!varOffboardingType} = "Resignation", "Resignation - Pending", "Terminated - Pending")</expression>
    </formulas>
    <formulas>
        <name>frmSummaryDetails</name>
        <dataType>String</dataType>
        <expression>"Employee: " &amp; {!varEmployeeName} &amp; " | Offboarding Type: " &amp; {!varOffboardingType} &amp; IF({!varOffboardingType} = "Resignation", " | Last Day: " &amp; TEXT({!varLastDay}) &amp; " | Exit Interview: " &amp; {!varExitInterviewPreference}, " | Termination Reason: " &amp; {!varTerminationReason} &amp; " | Immediate Access Revocation: " &amp; TEXT({!varImmediateAccessRevocation}))</expression>
    </formulas>
    <recordCreates>
