    <recordLookups>
        <name>Lookup_SelectedUser</name>
        <label>Lookup Selected User</label>
        <locationX>176</locationX>
        <locationY>228</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Assign_EmployeeName</targetReference>
