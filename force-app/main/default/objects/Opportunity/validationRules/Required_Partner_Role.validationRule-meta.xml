<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Required_Partner_Role</fullName>
    <active>false</active>
    <errorConditionFormula>AND(
    ISPICKVAL( Co_sell_Type__c , &apos;Services Co-sell&apos;),
    ISBLANK(   Partner_Role__c )
)</errorConditionFormula>
    <errorDisplayField>Partner_Role__c</errorDisplayField>
    <errorMessage>Partner Role is Required.</errorMessage>
</ValidationRule>
