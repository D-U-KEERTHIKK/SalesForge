<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Required_Customer_Purchase_Intent</fullName>
    <active>false</active>
    <errorConditionFormula>AND(
    OR(
      ISPICKVAL( Co_sell_Type__c , &apos;IP Co-sell&apos;)
    ),
    ISBLANK(TEXT(Customer_purchase_intent__c ))
)</errorConditionFormula>
    <errorDisplayField>Customer_purchase_intent__c</errorDisplayField>
    <errorMessage>Customer purchase intent is Required.</errorMessage>
</ValidationRule>
