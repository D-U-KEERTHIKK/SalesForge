<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Sold_Requires_Price</fullName>
    <active>true</active>
    <errorConditionFormula>AND(ISPICKVAL(Property_Status__c, "Sold"), ISBLANK(Price__c))</errorConditionFormula>
    <errorMessage>A sold property must have a price.</errorMessage>
</ValidationRule>