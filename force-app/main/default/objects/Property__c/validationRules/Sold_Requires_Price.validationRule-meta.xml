<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Sold_Requires_Price</fullName>
    <active>true</active>
    <description>Ensures that a sold property must have a price recorded</description>
    <errorConditionFormula>AND(ISPICKVAL(Property_Status__c, &quot;Sold&quot;), ISBLANK(Price__c))</errorConditionFormula>
    <errorDisplayField>Price__c</errorDisplayField>
    <errorMessage>A sold property must have a price.</errorMessage>
</ValidationRule>